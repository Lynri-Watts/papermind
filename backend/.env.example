# ============ LLM 兼容层（OpenAI 格式，必填） ============
# 任何兼容 OpenAI 格式的服务均可：OpenAI / DeepSeek / 智谱 / Moonshot ...
# 例：
#   OpenAI:   LLM_BASE_URL=https://api.openai.com/v1
#   DeepSeek: LLM_BASE_URL=https://api.deepseek.com/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-你的key
LLM_MODEL=gpt-4o-mini

# ============ 论文数据源（可选） ============
# Semantic Scholar API key（可选，https://www.semanticscholar.org/product/api#api-key-form 注册）
# 未填写时使用匿名限流（共享池）；填写后可显著提高限流。
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex 礼貌请求邮箱（可选，填写后进入 polite pool，限流提升至 100 req/s）
OPENALEX_MAILTO=

# CORE API key（可选，https://core.ac.uk/services/api 注册）
# 未填写时匿名可用，但限流较严（约 5 次/10 秒）；填写后限流提升。
CORE_API_KEY=

# 数据源启用状态与聚合优先级（逗号分隔，越靠前越优先；未列出的即为停用）
# 由前端「设置」页维护；留空 = 全部启用，顺序为 semantic_scholar,openalex,arxiv,core
SOURCE_PRIORITY=

# ============ 服务 ============
HOST=127.0.0.1
PORT=5001
DEBUG=1
