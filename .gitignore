# ============================================================
# 密钥与环境配置
# .env 只含 HOST/PORT/DEBUG 等非敏感服务配置，无需忽略。
# LLM/数据源 key 由「设置」页维护，保存在被忽略的 backend/data/ 数据库中。
# 若手工放置其它含密钥的本地文件，请使用 *.local 后缀。
# ============================================================
*.local

# ============================================================
# 用户运行时数据：SQLite 数据库（含 WAL/SHM）、PDF 磁盘缓存、
# 工作区文件（backend/data/workspaces/）——均为本机用户数据
# ============================================================
backend/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ============================================================
# 日志
# ============================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================
# Node / 前端构建产物与缓存
# ============================================================
node_modules/
dist/
dist-ssr/
coverage/
.vite/
*.tsbuildinfo

# ============================================================
# Python 字节码、虚拟环境与工具缓存
# ============================================================
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage

# ============================================================
# 编辑器与系统文件
# ============================================================
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


presentation stuff/

.trae/